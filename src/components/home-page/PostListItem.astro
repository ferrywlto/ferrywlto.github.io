---
import ItemDateLabel from "./ItemDateLabel.astro";
import ItemTitleLink from "./ItemTitleLink.astro";

export interface Props {
  title: string;
  date: string;
  subtitle: string;
  link: string;
}

const { title, date, subtitle, link } = Astro.props;
---
<!--
  Let the title link handle its own navigation.
  Only clicks outside a link use the row's post destination.
-->
<div
  class="surface-background-hover column-container"
  onclick={`if (!event.target.closest('a')) {
    window.location.href = ${JSON.stringify(link)};
  }`}
>
  <div class="title-row">
    <ItemDateLabel date={date} />
    <ItemTitleLink title={title} link={link} />
  </div>
  <p class="text-item-subtitle hide-on-mobile post-description">{subtitle}</p>
</div>

<style>
  .post-description {
    margin: 0;
  }

  .surface-background-hover {
    cursor: pointer;
  }

  .column-container {
    padding: var(--gap-sm) 0;
    gap: var(--gap-md);
  }

  .title-row {
    display: flex;
    width: 100%;
    align-items: center;
    gap: var(--gap-md);
  }

  @media screen and (max-width: 1024px) {
    .title-row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--gap-sm);
    }
  }
</style>
