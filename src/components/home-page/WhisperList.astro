---
import WhispersListItem from "./WhisperListItem.astro";
import type { WhisperPost } from "../../types";

export interface Props {
    posts: Array<WhisperPost>
}

const { posts } = Astro.props;
---

<div class="column-container">
  {
    posts.map(({ data, body, id }) => (
      <WhispersListItem
        author={data.author}
        text={body}
        link={`/whispers#${id}`}
      />
    ))
  }
</div>

<style>
  .column-container {
    gap: var(--gap-md);
  }
</style>
