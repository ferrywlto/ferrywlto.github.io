---
import MenuLink from "../MenuLink.astro";
import ThemeToggle from "../ThemeToggle.astro";
import CloseButton from "./CloseButton.astro";
---

<div
  x-data
  x-show="$store.drawer"
  x-on:click="closeDrawer()"
  x-transition.duration.300ms
  x-transition.opacity
  x-cloak
  class="drawer-overlay"
>
</div>
<div
  x-data
  x-cloak
  x-show="$store.drawer"
  class="drawer"
  id="site-drawer"
  x-on:keydown.escape.window="if ($store.drawer) { $event.preventDefault(); closeDrawer(); }"
>
  <div x-data class="drawer-header" x-on:close-button-clicked="closeDrawer()">
    <ThemeToggle />
    <h2 class="text-item-title">ferrywl.to</h2>
    <CloseButton />
  </div>
  <nav class="drawer-nav">
    <div class="nav-item"><MenuLink href="/">🏠 Home</MenuLink></div>
    <div class="nav-item"><MenuLink href="/blogs">📝 Blog</MenuLink></div>
    <div class="nav-item"><MenuLink href="/diaries">📓 Diary</MenuLink></div>
    <div class="nav-item">
      <MenuLink href="/whispers">💬 Whispers</MenuLink>
    </div>
    <div class="nav-item">
      <MenuLink href="/projects">🚀 Projects</MenuLink>
    </div>
    <div class="nav-item"><MenuLink href="/about">👨🏻‍💻 About</MenuLink></div>
  </nav>
</div>
<script>
  import Alpine from "alpinejs";

  let closing = false;

  //@ts-ignore
  window.closeDrawer = function () {
    const drawer = document.querySelector(".drawer");
    if (!drawer || !Alpine.store("drawer") || closing) return;

    // Without an animation, close promptly and return keyboard focus.
    // Otherwise, wait for the existing 300ms slide-out animation.
    const closeDelay = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches ? 0 : 300;

    closing = true;
    drawer.classList.remove("drawer-open");
    drawer.classList.add("drawer-close");

    setTimeout(() => {
      drawer.classList.remove("drawer-close");
      Alpine.store("drawer", false);
      closing = false;

      Alpine.nextTick(() => {
        const trigger = document.querySelector<HTMLButtonElement>(".hamburger");

        if (trigger?.getClientRects().length && !Alpine.store("drawer")) {
          trigger.focus({ preventScroll: true });
        }
      });
    }, closeDelay);
  };

  // Keep focus within drawer menu items on pressing tab. So it won't set focus to footer after About. Instead focusing back to the theme button.
  document.addEventListener('keydown', (event) => {
    // Apply containment only to Tab, while the mobile drawer is open.
    if (
      event.key !== 'Tab' ||
      !Alpine.store('drawer') ||
      !window.matchMedia('(max-width: 1024px)').matches
    ) return;

    const drawer = document.querySelector('#site-drawer');
    if (!drawer) return;

    // Find the drawer's links and enabled buttons in their HTML order.
    // HTMLElement supplies typed access to tabIndex and focus().
    const controls = Array.from(
      drawer.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled])'
      )
    ).filter(control =>
      // Negative tabIndex excludes a control from normal Tab navigation.
      // No layout rectangles means it is hidden by the current layout.
      control.tabIndex >= 0 && control.getClientRects().length > 0
    );

    const first = controls[0];
    const last = controls[controls.length - 1];

    // An empty list has no destination to focus.
    if (!first || !last) return;

    const active = document.activeElement;

    // Recover on the next Tab if focus has moved behind the drawer.
    const outside = !drawer.contains(active);

    if (event.shiftKey && (outside || active === first)) {
      // At the beginning, Shift–Tab wraps backwards to the last control.
      // Cancel the browser's default movement before choosing a destination.
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && (outside || active === last)) {
      // At the end, Tab wraps forwards to the first control.
      event.preventDefault();
      first.focus();
    }
  });
</script>
<style>
  [x-cloak] {
    display: none !important;
  }

  @media screen and (max-width: 1024px) {
    .drawer-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: color-mix(in srgb, var(--color-shadow) 10%, transparent);
      backdrop-filter: blur(8px) brightness(0.8);
      -webkit-backdrop-filter: blur(8px) brightness(0.8);
      z-index: 998;
      cursor: pointer;
    }

    .drawer {
      position: fixed;
      top: 0;
      left: 0;
      width: 50%;
      height: 100vh;
      background: var(--color-bg);
      z-index: 999;
      display: flex;
      flex-direction: column;
      /* animation: slideInFromLeft 0.3s ease-out; */
    }

    .drawer-open {
      animation: slideInFromLeft 0.3s ease-out;
    }

    .drawer-close {
      animation: slideOutToLeft 0.3s ease-in;
    }

    @keyframes slideOutToLeft {
      from {
        transform: translateX(0);
      }
      to {
        transform: translateX(-100%);
      }
    }

    @keyframes slideInFromLeft {
      from {
        transform: translateX(-100%);
      }
      to {
        transform: translateX(0);
      }
    }

    .close-button {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      cursor: pointer;
      border-radius: var(--corner-sm);
      background: transparent;
      color: var(--color-text);
      font-size: 1.2rem;
      transition: background-color 0.2s ease;
    }

    .close-button:hover {
      background: var(--color-hover);
    }

    .drawer-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--color-surface);
      padding: var(--gap-lg);
      box-shadow: var(--shadow-drawer);
      box-sizing: border-box;
      height: 3.8rem;

      border-bottom: 1px solid var(--color-shadow);
    }

    .drawer-nav {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      align-items: flex-start;
      /* gap: var(--gap-xl); */

      box-sizing: border-box;
      background-color: var(--color-bg);
    }

    .nav-item {
      display: flex;
      justify-content: flex-start;
      align-items: center;
      width: 100%;
      padding: var(--gap-lg);
      box-sizing: border-box;
      border-bottom: 1px solid var(--color-shadow);
    }
  }
</style>
