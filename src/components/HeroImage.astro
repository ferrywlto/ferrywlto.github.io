---
import { Image } from 'astro:assets';

export interface Props {
  src?: string | ImageMetadata;
  alt: string;
  class?: string;
}

const { src, alt, class: className = '' } = Astro.props;
---

<div class={`hero-image ${className}`}>
  {
    src && (
      typeof src === "string" ?
        // For remote image with URL string
        (<Image inferSize src={src} alt={alt} />) :
        // For local image with ImageMetadata
        (<Image src={src} alt={alt} />)
    )
  }
</div>

<style>
  .hero-image {
    margin-bottom: var(--gap-lg);
  }

  /* Article images retain their natural proportions. */
  .hero-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--corner-md);
  }

  /* Archive previews have a consistent frame. */
  .hero-image.preview-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--corner-md);
    background: var(--color-surface);
    box-shadow: var(--photo-box-shadow);
  }

  .hero-image.preview-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    border-radius: 0;
  }
</style>
