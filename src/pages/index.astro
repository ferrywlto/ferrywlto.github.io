---
import PostList from "../components/home-page/PostList.astro";
import ProjectList from "../components/home-page/ProjectList.astro";
import WhisperList from "../components/home-page/WhisperList.astro";
import SectionContainer from "../components/home-page/SectionContainer.astro";

import HeroCard from "../components/home-page/HeroCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getTopPublishedPostsOrderByDateDesc } from "../helpers";
import type { PostPreview } from "../types";

function toPostPreview(posts: PostPreview[]){
  return posts.map((post) => ({
    title: post.data.title,
    date: post.data.pubDate.toISOString().split('T')[0],
    subtitle: post.data.description,
    link: `./${post.collection}/${post.id}`,
  }));
}
const [allBlogs, allDiaries, allWhispers, allProjects] =
  await Promise.all([
    getCollection("blogs"),
    getCollection("diaries"),
    getCollection("whispers"),
    getCollection("projects"),
  ]);

const blogs = toPostPreview(
  getTopPublishedPostsOrderByDateDesc(allBlogs, 3)
);

const diaries = toPostPreview(
  getTopPublishedPostsOrderByDateDesc(allDiaries, 3)
);

const whispers =
  getTopPublishedPostsOrderByDateDesc(allWhispers, 3);

const projects =
  getTopPublishedPostsOrderByDateDesc(allProjects, 3);
---

<BaseLayout>
  <div class="width-constrained-container column-container wrapper">
    <HeroCard />
    <hr />

    <div class="content-container">
      <div class="column-container content-list">
        <SectionContainer title="Tech Blog" linkText="All posts" link="./blogs">
          <PostList posts={blogs} />
        </SectionContainer>

        <SectionContainer title="Diary" linkText="Archive" link="./diaries">
          <PostList posts={diaries} />
        </SectionContainer>

        <SectionContainer title="Whispers" linkText="Archive" link="./whispers">
          <WhisperList posts={whispers} />
        </SectionContainer>

        <SectionContainer title="Projects" linkText="All projects" link="./projects">
          <ProjectList posts={projects} />
        </SectionContainer>
      </div>
    </div>
  </div>
</BaseLayout>
<style>
  .wrapper {
    gap: var(--gap-lg);
  }

  .content-list {
    gap: var(--gap-xl);
  }

  .content-container {
    padding: var(--gap-lg);
  }
</style>
